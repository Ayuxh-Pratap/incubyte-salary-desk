# Use a separate hosted branch for each environment. Never paste secrets into chat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
DATABASE_PURPOSE=development
# Required on preview; set to a dedicated preview branch, never demo.
# VERCEL_ENV is provided by Vercel.
SESSION_SECRET=replace-with-at-least-32-random-characters
EVALUATOR_PASSWORD=replace-with-a-long-random-passphrase
APP_ORIGIN=http://localhost:3000
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ISOLATED-TEST-HOST/DB?sslmode=verify-full
TEST_DATABASE_PURPOSE=test
# Required for guarded synthetic reset, never enabled by default.
ALLOW_DEMO_RESET=false


# Optional operator-only connections for separate synthetic deployment databases.
DEMO_DATABASE_URL=
DEMO_DATABASE_DIRECT_URL=
PREVIEW_DATABASE_URL=
PREVIEW_DATABASE_DIRECT_URL=
# APP_ORIGIN is required locally; Vercel-issued deployment URLs are allowlisted automatically.
