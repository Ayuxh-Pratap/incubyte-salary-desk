  "salary": {
    "title": "Salary-update sequence",
    "description": "A salary proposal crosses access and validation checks, then a conditional write. Invalid input and a stale version preserve the draft; only a returned update produces success.",
    "kind": "flow",
    "graph": {
      "width": 1280,
      "height": 590,
